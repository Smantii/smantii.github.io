---
layout: page
---
{%- if site.cv_pdf %}
<p class="cv-actions"><a class="btn btn--primary" href="{{ site.cv_pdf | relative_url }}">{% include icon.liquid name="file" %} Download CV (PDF)</a></p>
{%- endif %}
<div class="cv">
  {%- for section in site.data.cv %}
  <section class="cv-section" data-reveal>
    <h2 class="cv-title eyebrow"><span class="num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span> {{ section.title }}</h2>
    <div class="cv-content">
    {%- case section.type -%}
      {%- when "map" %}
      <dl class="cv-map">
        {%- for row in section.contents %}<div><dt>{{ row.name }}</dt><dd>{{ row.value }}</dd></div>{% endfor %}
      </dl>
      {%- when "time_table" %}
      <ol class="cv-list">
        {%- for item in section.contents %}
        <li class="cv-item">
          <p class="cv-year">{{ item.year }}</p>
          <div>
            {%- if item.title %}<h3>{{ item.title }}</h3>{% endif %}
            {%- if item.institution %}<p class="cv-inst">{{ item.institution }}</p>{% endif %}
            {%- if item.description %}
              {%- if item.description.first %}
              <ul>{% for d in item.description %}<li>{{ d }}</li>{% endfor %}</ul>
              {%- else %}<p>{{ item.description }}</p>{% endif %}
            {%- endif %}
            {%- if item.items %}<ul>{% for d in item.items %}<li>{{ d }}</li>{% endfor %}</ul>{% endif %}
          </div>
        </li>
        {%- endfor %}
      </ol>
      {%- when "nested_list" %}
      <div class="cv-nested">
        {%- for group in section.contents %}
        <div><h3>{{ group.title }}</h3><p class="tags">{% for i in group.items %}<span class="tag">{{ i }}</span>{% endfor %}</p></div>
        {%- endfor %}
      </div>
      {%- when "text" %}
      <p class="cv-text">{{ section.contents }}</p>
      {%- when "list" %}
      <ul class="cv-plain">{% for i in section.contents %}<li>{{ i }}</li>{% endfor %}</ul>
    {%- endcase %}
    </div>
  </section>
  {%- endfor %}
</div>
