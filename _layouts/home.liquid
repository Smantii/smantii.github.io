---
layout: default
---
<section class="hero" aria-labelledby="hero-title">
  <canvas class="flow" aria-hidden="true"></canvas>
  <div class="wrap hero-grid">
    <div class="hero-text">
      <p class="eyebrow sticker" data-reveal>{{ page.eyebrow }}</p>
      <h1 class="display" id="hero-title" data-split>{{ page.headline }}</h1>
      <p class="lede" data-reveal>{{ page.intro }}</p>
      <div class="hero-cta" data-reveal>
        <a class="btn btn--primary" href="{{ '/cv/' | relative_url }}" data-color="aqua">View my CV {% include icon.liquid name="arrow" %}</a>
        <a class="btn btn--ghost" href="{{ '/publications/' | relative_url }}" data-color="cyan">Explore the research</a>
      </div>
    </div>

    <figure class="portrait" data-reveal>
      <span class="portrait-shard portrait-shard--1" aria-hidden="true"></span>
      <span class="portrait-shard portrait-shard--2" aria-hidden="true"></span>
      <div class="portrait-frame tilt">
        <img src="{{ '/assets/img/' | append: page.portrait | relative_url }}" alt="Portrait of {{ site.first_name }} {{ site.last_name }}" width="1084" height="1451" fetchpriority="high">
      </div>
      {%- if page.bubble %}
      <figcaption class="bubble"><span>{{ page.bubble }}</span> <span class="wave-hand" aria-hidden="true">👋</span></figcaption>
      {%- endif %}
    </figure>
  </div>

  <div class="wrap hero-foot">
    <dl class="facts">
      {%- for fact in page.facts %}
      <div data-reveal><dt>{{ fact.label }}</dt><dd>{{ fact.value }}</dd></div>
      {%- endfor %}
    </dl>
  </div>
</section>

<div class="tickers" aria-hidden="true">
  {%- for band in (1..2) %}
  <div class="ticker ticker--{{ band }}">
    <div class="ticker-track">
      {%- for round in (1..2) %}
      <div class="ticker-group">
        {%- for word in site.ticker %}
        <span>{{ word }}</span>{% include doodle.liquid name="sparkle" class="ticker-star" %}
        {%- endfor %}
      </div>
      {%- endfor %}
    </div>
  </div>
  {%- endfor %}
</div>

<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap split">
    <header class="section-head" data-reveal>
      <p class="eyebrow sticker">About</p>
      <h2 class="h2" id="about-title">Research rigor,<br><em class="scribble">production</em> mindset.</h2>
      {% include doodle.liquid name="slash" class="about-doodle" %}
    </header>
    <div class="prose prose--lead" data-reveal>
      {{ content }}
    </div>
  </div>
</section>

<section class="section section--tint" id="focus" aria-labelledby="focus-title">
  <div class="wrap">
    <header class="section-head section-head--row" data-reveal>
      <div>
        <p class="eyebrow sticker">Focus</p>
        <h2 class="h2" id="focus-title">What I work <em class="scribble">on</em></h2>
      </div>
    </header>
    <ol class="focus-grid">
      {%- for item in page.focus %}
      <li class="focus-card tilt" data-reveal data-fill="{{ item.color }}">
        <span class="focus-icon">{% include doodle.liquid name=item.icon %}</span>
        <h3>{{ item.title }}</h3>
        <p>{{ item.text }}</p>
        <p class="tags">{% for t in item.tags %}<span class="tag">{{ t }}</span>{% endfor %}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section" id="selected" aria-labelledby="selected-title">
  <div class="wrap">
    <header class="section-head section-head--row" data-reveal>
      <div>
        <p class="eyebrow sticker">Selected publications</p>
        <h2 class="h2" id="selected-title">Recent <em class="scribble">work</em></h2>
      </div>
      <a class="btn btn--small" href="{{ '/publications/' | relative_url }}" data-color="cyan">All publications {% include icon.liquid name="arrow" %}</a>
    </header>
    <div class="pubs pubs--selected" data-reveal>
      {% bibliography --group_by none --query @*[selected=true]* %}
    </div>
  </div>
</section>

<section class="section section--tint" id="writing" aria-labelledby="writing-title">
  <div class="wrap">
    <header class="section-head section-head--row" data-reveal>
      <div>
        <p class="eyebrow sticker">Writing</p>
        <h2 class="h2" id="writing-title">Notes from the <em class="scribble">lab</em></h2>
      </div>
      <a class="btn btn--small" href="{{ '/blog/' | relative_url }}" data-color="ice">All posts {% include icon.liquid name="arrow" %}</a>
    </header>
    {%- if site.posts.size > 0 %}
    <div class="post-grid">
      {%- for post in site.posts limit: 3 %}
        {% include post-card.liquid post=post %}
      {%- endfor %}
    </div>
    {%- else %}
    <p class="empty" data-reveal>The first post is on its way.</p>
    {%- endif %}
  </div>
</section>

<section class="section" id="news" aria-labelledby="news-title">
  <div class="wrap split">
    <header class="section-head" data-reveal>
      <p class="eyebrow sticker">Lately</p>
      <h2 class="h2" id="news-title"><em class="scribble">News</em></h2>
      <p class="muted">Open source: {% for p in site.data.repositories %}{% if p.featured %}<a href="https://github.com/{{ p.repo }}">{{ p.name }}</a>{% unless forloop.last %}, {% endunless %}{% endif %}{% endfor %} and more on the <a href="{{ '/projects/' | relative_url }}">projects page</a>.</p>
    </header>
    <ol class="timeline">
      {%- assign news = site.news | sort: "date" | reverse -%}
      {%- for item in news limit: 6 %}
      <li data-reveal>
        <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: "%b %Y" }}</time>
        <div>{{ item.content | remove: '<p>' | remove: '</p>' }}</div>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

{% include contact.liquid %}
