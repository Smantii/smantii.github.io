---
layout: default
---
{%- comment -%}
  Home page. The hero is the view across the Strait of Messina at dawn (or at
  night, in dark mode), drawn live by assets/js/strait.js. The text lives in the
  front matter of _pages/about.md.
{%- endcomment -%}
{%- capture pub_count %}{% bibliography_count %}{% endcapture -%}
{%- assign news = site.news | sort: "date" | reverse -%}

<section class="hero" aria-labelledby="hero-title">
  {% include sky.liquid kind="hero" %}
  <div class="wrap hero-text enter">
    <p class="hero-role">
      <span class="eyebrow">{{ page.eyebrow }}</span>
      {%- if page.status %}<span class="status">{{ page.status }}</span>{% endif %}
    </p>
    <h1 class="display" id="hero-title">{{ page.headline }}</h1>
    <p class="hero-intro">{{ page.intro }}</p>
    <div class="cta">
      <a class="btn btn--primary" href="{{ '/cv/' | relative_url }}">View my CV {% include icon.liquid name="arrow" %}</a>
      <a class="btn btn--ghost" href="{{ '/publications/' | relative_url }}">Explore the research</a>
    </div>
  </div>

  <div class="wrap hero-foot">
    <p class="hero-readout" aria-hidden="true">
      <span>Sicily, seen from Reggio Calabria</span>
      <span data-readout data-still="Still air. The city rises." data-rising="The air is settling." data-wind="Wind. The city is gone.">The air is settling.</span>
    </p>
    <nav class="hero-index" aria-label="On this page">
      <ol>
        {%- for item in page.menu %}
        <li><a href="#{{ item.id }}" title="{{ item.hint | escape }}"><span aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>{{ item.title }}</a></li>
        {%- endfor %}
      </ol>
    </nav>
  </div>
</section>

<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap about">
    <figure class="about-portrait">
      <img src="{{ '/assets/img/' | append: page.portrait | relative_url }}" alt="Portrait of {{ site.first_name }} {{ site.last_name }}" width="748" height="1000" loading="lazy" decoding="async">
    </figure>
    <div class="about-text">
      <header class="section-head">
        <p class="kicker"><b>01</b> About</p>
        <h2 class="h2" id="about-title">Research rigor, <em>production</em> mindset.</h2>
      </header>
      <div class="prose prose--lead">
        {{ content }}
      </div>
    </div>
  </div>
  <div class="wrap">
    <dl class="sheet">
      {%- for fact in page.facts %}
      <div><dt>{{ fact.label }}</dt><dd>{{ fact.value }}</dd></div>
      {%- endfor %}
    </dl>
    <ul class="counts">
      <li><a href="{{ '/publications/' | relative_url }}"><b>{{ pub_count | strip }}</b><span>Publications</span>{% include icon.liquid name="arrow" %}</a></li>
      <li><a href="{{ '/projects/' | relative_url }}"><b>{{ site.data.repositories.size }}</b><span>Open-source projects</span>{% include icon.liquid name="arrow" %}</a></li>
      <li><a href="{{ '/blog/' | relative_url }}"><b>{{ site.posts.size }}</b><span>Blog posts</span>{% include icon.liquid name="arrow" %}</a></li>
    </ul>
  </div>
</section>

<section class="section section--sand" id="focus" aria-labelledby="focus-title">
  <div class="wrap">
    <header class="section-head">
      <p class="kicker"><b>02</b> Focus</p>
      <h2 class="h2" id="focus-title">What I work <em>on</em></h2>
    </header>
    <ol class="focus">
      {%- for item in page.focus %}
      <li>
        <p class="focus-top"><span class="focus-n">{{ forloop.index | prepend: '0' }}</span><span class="focus-icon">{% include doodle.liquid name=item.icon %}</span></p>
        <h3>{{ item.title }}</h3>
        <p>{{ item.text }}</p>
        <p class="tags">{% for t in item.tags %}<span class="tag">{{ t }}</span>{% endfor %}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section" id="research" aria-labelledby="research-title">
  <div class="wrap">
    <header class="section-head section-head--row">
      <div>
        <p class="kicker"><b>03</b> Research</p>
        <h2 class="h2" id="research-title">Selected <em>publications</em></h2>
      </div>
      <a class="btn btn--ghost btn--small" href="{{ '/publications/' | relative_url }}">All publications {% include icon.liquid name="arrow" %}</a>
    </header>
    <div class="pubs pubs--home">
      {% bibliography --group_by none --query @*[selected=true]* %}
    </div>
  </div>
</section>

<section class="section section--sand" id="writing" aria-labelledby="writing-title">
  <div class="wrap">
    <header class="section-head section-head--row">
      <div>
        <p class="kicker"><b>04</b> Writing</p>
        <h2 class="h2" id="writing-title">Postcards from the <em>Strait</em></h2>
      </div>
      <a class="btn btn--ghost btn--small" href="{{ '/blog/' | relative_url }}">All posts {% include icon.liquid name="arrow" %}</a>
    </header>
    {%- if site.posts.size > 0 %}
    <div class="postcards">
      {%- for post in site.posts limit: 2 %}
      {% include post-card.liquid post=post %}
      {%- endfor %}
    </div>
    {%- else %}
    <p class="empty">The first post is on its way.</p>
    {%- endif %}
  </div>
</section>

<section class="section" id="news" aria-labelledby="news-title">
  <div class="wrap news">
    <header class="section-head">
      <p class="kicker"><b>05</b> News</p>
      <h2 class="h2" id="news-title">The <em>logbook</em></h2>
      <p class="muted">Open source: {% for p in site.data.repositories %}{% if p.featured %}<a href="https://github.com/{{ p.repo }}">{{ p.name }}</a>{% unless forloop.last %}, {% endunless %}{% endif %}{% endfor %} and more on the <a href="{{ '/projects/' | relative_url }}">projects page</a>.</p>
    </header>
    <ol class="log">
      {%- for item in news limit: 6 %}
      <li>
        <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: "%b %Y" }}</time>
        <p>{{ item.content | remove: '<p>' | remove: '</p>' }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact-grid">
    <div>
      <p class="kicker"><b>06</b> Contact</p>
      <h2 class="display display--md" id="contact-title">Let’s build something <em>together</em>.</h2>
      <p class="lede">{{ site.contact_note }}</p>
    </div>
    <ul class="choices">
      <li><a href="mailto:{{ site.email | encode_email }}">{% include icon.liquid name="mail" %}<span><b>Send an email</b><small>{{ site.email }}</small></span>{% include icon.liquid name="arrow-up-right" %}</a></li>
      {%- if site.social.linkedin %}
      <li><a href="https://www.linkedin.com/in/{{ site.social.linkedin }}">{% include icon.liquid name="linkedin" %}<span><b>Connect on LinkedIn</b><small>in/{{ site.social.linkedin }}</small></span>{% include icon.liquid name="arrow-up-right" %}</a></li>
      {%- endif %}
      {%- if site.social.telegram %}
      <li><a href="https://t.me/{{ site.social.telegram }}">{% include icon.liquid name="telegram" %}<span><b>Message on Telegram</b><small>@{{ site.social.telegram }}</small></span>{% include icon.liquid name="arrow-up-right" %}</a></li>
      {%- endif %}
      {%- if site.social.discord %}
      <li><span class="choice-static">{% include icon.liquid name="discord" %}<span><b>Find me on Discord</b><small>{{ site.social.discord }}</small></span></span></li>
      {%- endif %}
    </ul>
  </div>
</section>
