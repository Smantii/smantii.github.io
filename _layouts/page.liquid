---
layout: default
---
<header class="page-head">
  <canvas class="flow flow--band" aria-hidden="true"></canvas>
  <div class="wrap">
    {%- if page.eyebrow %}<p class="eyebrow" data-reveal>{{ page.eyebrow }}</p>{% endif %}
    <h1 class="display display--md" data-reveal>{{ page.heading | default: page.title }}</h1>
    {%- if page.description %}<p class="lede" data-reveal>{{ page.description }}</p>{% endif %}
  </div>
</header>
<div class="wrap page-body {% if page.narrow %}wrap--narrow{% endif %}">
  {{ content }}
</div>
