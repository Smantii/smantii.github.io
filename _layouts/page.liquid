---
layout: default
---
<header class="page-head">
  {% include sky.liquid kind="band" %}
  <div class="wrap enter">
    {%- if page.eyebrow %}<p class="eyebrow">{{ page.eyebrow }}</p>{% endif %}
    <h1 class="display display--md">{{ page.heading | default: page.title }}</h1>
    {%- if page.description %}<p class="lede">{{ page.description }}</p>{% endif %}
  </div>
</header>
<div class="wrap page-body {% if page.narrow %}wrap--narrow{% endif %}">
  {{ content }}
</div>
