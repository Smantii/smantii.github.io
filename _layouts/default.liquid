<!doctype html>
{%- assign section_color = "navy" -%}
{%- for item in site.nav -%}
  {%- if page.url contains item.url -%}{%- assign section_color = item.color -%}{%- endif -%}
{%- endfor -%}
{%- if page.layout == "post" -%}{%- assign section_color = "ice" -%}{%- endif -%}
<html lang="{{ page.lang | default: site.lang }}" data-color="{{ section_color }}">
  <head>
    {% include head.liquid %}
  </head>
  <body class="layout-{{ page.layout | default: 'page' }}">
    <a class="skip-link" href="#main">Skip to content</a>
    {% include header.liquid %}
    <main id="main">
      {{ content }}
    </main>
    {% include footer.liquid %}

    <!-- Page transition: Persona-style diagonal bands with the destination's name. -->
    <div class="wipe" aria-hidden="true">
      <span class="wipe-band wipe-band--1"></span>
      <span class="wipe-band wipe-band--2"></span>
      <span class="wipe-band wipe-band--3"></span>
      <div class="wipe-title">
        <img class="wipe-mark" src="{{ '/assets/img/apple-touch-icon.png' | relative_url | bust_file_cache }}" alt="" width="180" height="180">
        <span class="wipe-label"></span>
      </div>
    </div>
    <script>
      (function () {
        var l = document.documentElement.getAttribute("data-wipe-label");
        if (l) document.querySelector(".wipe-label").textContent = l;
      })();
    </script>
  </body>
</html>
