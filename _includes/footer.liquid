<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-col">
      <a class="brand brand--small" href="{{ '/' | relative_url }}">
        <img class="brand-mark" src="{{ '/assets/img/apple-touch-icon.png' | relative_url | bust_file_cache }}" alt="" width="180" height="180">
        <span class="brand-name">{{ site.first_name }} <em>{{ site.last_name }}</em></span>
      </a>
      <p class="footer-meta">{{ site.role }}</p>
    </div>
    <figure class="footer-quote">
      <blockquote>“{{ site.quote | remove: '"' }}”</blockquote>
      <figcaption>— {{ site.quote_author }}</figcaption>
    </figure>
    <div class="footer-col footer-col--end">
      {% include social.liquid all=true %}
      <p class="footer-meta">© {{ 'now' | date: '%Y' }} · <a href="{{ '/blog/feed.xml' | relative_url }}">RSS</a></p>
    </div>
  </div>
</footer>
