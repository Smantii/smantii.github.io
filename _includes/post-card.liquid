{%- comment -%} A post as a postcard. Usage: {% include post-card.liquid post=post %} {%- endcomment -%}
{%- assign p = include.post -%}
{%- assign words = p.content | strip_html | number_of_words -%}
{%- assign minutes = words | plus: 120 | divided_by: 200 | at_least: 1 -%}
<a class="postcard" href="{{ p.url | relative_url }}">
  <span class="postcard-picture">
    {%- if p.card %}<img src="{{ p.card | relative_url }}" alt="" loading="lazy" decoding="async" width="1424" height="496">{% endif -%}
  </span>
  <span class="postcard-body">
    <span class="eyebrow"><time datetime="{{ p.date | date_to_xmlschema }}">{{ p.date | date: "%B %-d, %Y" }}</time> · {{ minutes }} min read</span>
    <span class="postcard-title">{{ p.title }}</span>
    {%- if p.description %}<span class="postcard-desc">{{ p.description }}</span>{% endif %}
    <span class="link-arrow">Read the post {% include icon.liquid name="arrow" %}</span>
  </span>
</a>
