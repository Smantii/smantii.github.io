<header class="site-header" data-open="false">
  <div class="wrap header-inner">
    <a class="brand" href="{{ '/' | relative_url }}" aria-label="{{ site.title }} — home">
      <img class="brand-mark" src="{{ '/assets/img/apple-touch-icon.png' | relative_url | bust_file_cache }}" alt="" width="180" height="180">
      <span class="brand-name">{{ site.first_name }} <em>{{ site.last_name }}</em></span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Primary">
      {%- for item in site.nav -%}
        {%- assign active = false -%}
        {%- if page.url contains item.url -%}{%- assign active = true -%}{%- endif -%}
        {%- if item.url == '/blog/' and page.layout == 'post' -%}{%- assign active = true -%}{%- endif -%}
        <a class="nav-link" href="{{ item.url | relative_url }}" data-color="{{ item.color }}" {% if active %}aria-current="page"{% endif %}>{{ item.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="header-actions">
      <button class="icon-btn theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <span class="when-light">{% include icon.liquid name="moon" %}</span>
        <span class="when-dark">{% include icon.liquid name="sun" %}</span>
      </button>
      <button class="icon-btn menu-toggle" type="button" aria-label="Open menu" aria-controls="site-nav" aria-expanded="false">
        <span class="when-closed">{% include icon.liquid name="menu" %}</span>
        <span class="when-open">{% include icon.liquid name="close" %}</span>
      </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true"><span></span></div>
</header>
