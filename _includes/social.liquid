{%- assign s = site.social -%}
<ul class="social {{ include.class }}">
  {%- if s.linkedin %}<li><a href="https://www.linkedin.com/in/{{ s.linkedin }}" aria-label="LinkedIn" title="LinkedIn">{% include icon.liquid name="linkedin" %}{% if include.labels %}<span>LinkedIn</span>{% endif %}</a></li>{% endif -%}
  {%- if s.github %}<li><a href="https://github.com/{{ s.github }}" aria-label="GitHub" title="GitHub">{% include icon.liquid name="github" %}{% if include.labels %}<span>GitHub</span>{% endif %}</a></li>{% endif -%}
  {%- if s.scholar %}<li><a href="https://scholar.google.com/citations?user={{ s.scholar }}" aria-label="Google Scholar" title="Google Scholar">{% include icon.liquid name="scholar" %}{% if include.labels %}<span>Scholar</span>{% endif %}</a></li>{% endif -%}
  {%- if s.orcid %}<li><a href="https://orcid.org/{{ s.orcid }}" aria-label="ORCID" title="ORCID">{% include icon.liquid name="orcid" %}{% if include.labels %}<span>ORCID</span>{% endif %}</a></li>{% endif -%}
  {%- if include.all -%}
    {%- if s.telegram %}<li><a href="https://t.me/{{ s.telegram }}" aria-label="Telegram" title="Telegram">{% include icon.liquid name="telegram" %}{% if include.labels %}<span>Telegram</span>{% endif %}</a></li>{% endif -%}
    {%- if s.instagram %}<li><a href="https://www.instagram.com/{{ s.instagram }}" aria-label="Instagram" title="Instagram">{% include icon.liquid name="instagram" %}{% if include.labels %}<span>Instagram</span>{% endif %}</a></li>{% endif -%}
  {%- endif -%}
</ul>
